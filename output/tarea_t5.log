. ** 9. Una regresión por grupo, guardada en una matriz y e
> xportada
. levelsof `grupo_reg', local(sectores)
`"Agricultura"' `"Comercio"' `"Construcción"' `"Educación"'
>  `"Industria"' `"Servicios"'

. local k : word count `sectores'

. matrix R = J(`k', 3, .)

. 
. local i = 1

. foreach s of local sectores {
  2.     quietly regress `depvar' `xeduc' if `grupo_reg' ==
>  "`s'"
  3.     matrix R[`i', 1] = _b[`xeduc']
  4.     matrix R[`i', 2] = _se[`xeduc']
  5.     matrix R[`i', 3] = e(N)
  6.     local i = `i' + 1
  7. }

. matrix colnames R = beta_`xeduc' ee n

. matrix rownames R = `sectores'

. matrix list R, format(%9.0f)

R[6,3]
               beta_educ         ee          n
  Agricultura      37519       7556         13
     Comercio      24487       8529          6
 Construcción      23783      14122          5
    Educación      37368      12642          7
    Industria      42713      14514          9
    Servicios      32308       7924         15

. 
. putexcel set "output/tarea_t5_por_sector.xlsx", replace

. putexcel A1 = ("Sector") B1 = ("Beta `xeduc'") C1 = ("Err
> or est.") D1 = ("n")
file output/tarea_t5_por_sector.xlsx saved

. putexcel B2 = matrix(R)
file output/tarea_t5_por_sector.xlsx saved

. 
. local fila = 2

. foreach s of local sectores {
  2.     putexcel A`fila' = ("`s'")
  3.     local fila = `fila' + 1
  4. }
